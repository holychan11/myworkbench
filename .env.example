# ===== MyWorkbench 环境变量（可选）=====
# 复制本文件为 .env 后按需修改；不设置时系统会自动生成密钥、使用默认值，开箱即跑。

# 微信网关通道：console(本地测试，默认) | wecom(企业微信) | wcf(WeChatFerry) | onebot(QQ)
# GATEWAY_TYPE=console

# QQ（GATEWAY_TYPE=onebot，通过 NapCat/LLOneBot，OneBot 11 协议）
# ONE_BOT_HTTP_URL=http://127.0.0.1:3000

# 企业微信（GATEWAY_TYPE=wecom 时填写）
# WECOM_CORP_ID=
# WECOM_AGENT_ID=
# WECOM_SECRET=

# WeChatFerry（GATEWAY_TYPE=wcf 时填写）
# WCF_HOST=127.0.0.1
# WCF_PORT=10086

# A股盘前报告定时（每交易日）
# SCHEDULE_HOUR=8
# SCHEDULE_MINUTE=30

# 默认管理员（首次启动自动创建）
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin123456
